{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "buildCommand": "python build.py",
      "functions": {
        "app.py": {
          "maxDuration": 300,
          "includeFiles": "saved_models/**"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "cd .. && pnpm install",
      "buildCommand": "cd .. && pnpm --filter @workspace/driversafe run build",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
